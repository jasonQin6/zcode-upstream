{
  "name": "@zcode/dynamic-workflow-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "pretypecheck": "pnpm --filter @zcode/dynamic-workflow build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "lint:fix": "oxlint --write src test",
    "test": "node ../../../../node_modules/tsx/dist/cli.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@zcode/dynamic-workflow": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
